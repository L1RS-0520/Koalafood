#!/usr/bin/env node
// 生成本地 worker/.dev.vars：随机 CHEF_KEY（厨驼密钥）+ DEV_AUTH=1（本地模拟登录）。
// 只写文件、权限 600，绝不在终端显示密钥。已有 CHEF_KEY 时保留不动；加 --force 重新生成。
import { randomBytes } from "node:crypto";
import { existsSync, readFileSync, writeFileSync, chmodSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";

const file = join(dirname(fileURLToPath(import.meta.url)), "..", ".dev.vars");
const force = process.argv.includes("--force");
const lines = existsSync(file) ? readFileSync(file, "utf8").split(/\r?\n/).filter((l) => l.trim()) : [];
const has = (k) => lines.some((l) => l.startsWith(k + "="));
const set = (k, v) => { const i = lines.findIndex((l) => l.startsWith(k + "=")); if (i >= 0) lines[i] = `${k}=${v}`; else lines.push(`${k}=${v}`); };

let msg = [];
if (!has("CHEF_KEY") || force) { set("CHEF_KEY", randomBytes(32).toString("base64url")); msg.push("已生成新的 CHEF_KEY（不显示）"); }
else msg.push("CHEF_KEY 已存在，保留不动（要换请加 --force）");
if (!has("DEV_AUTH")) { set("DEV_AUTH", "1"); msg.push("已写入 DEV_AUTH=1（本地模拟登录）"); }
writeFileSync(file, lines.join("\n") + "\n", { mode: 0o600 });
chmodSync(file, 0o600);
console.log(`${msg.join("；")}。文件：${file}（权限 600，已在 .gitignore 中）`);
console.log("改了 .dev.vars 后需要重启 wrangler dev 才生效。");
