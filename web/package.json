{
  "name": "koala-canteen-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock --outDir dist-mock",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "shots": "node scripts/shots.mjs",
    "preview:mock": "vite preview --outDir dist-mock --port 4174",
    "test:unit": "node --test --experimental-strip-types scripts/compress.test.ts scripts/copy.test.ts scripts/editPatch.test.ts",
    "test:issue": "node scripts/issue-ui-test.mjs",
    "test:patch": "node scripts/patch-rule-test.mjs",
    "test:compress": "node scripts/compress-browser-test.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
